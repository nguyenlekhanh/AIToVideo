{
  "_meta": {
    "title": "Wan2.1 I2V 480p (API format)",
    "notes": "Standard Wan2.1 image-to-video graph. Provider substitutes: CLIPTextEncode texts, KSampler seed, WanImageToVideo width/height/length, LoadImage image."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "Wan2_1-I2V-14B-480p_fp8_e4m3fn_scaled_KJ.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__POSITIVE_PROMPT__",
      "clip": ["2", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, distorted, watermark, static",
      "clip": ["2", 0]
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__INPUT_IMAGE__"
    }
  },
  "8": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["3", 0],
      "image": ["7", 0],
      "crop": "center"
    }
  },
  "9": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "vae": ["4", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1,
      "clip_vision_output": ["8", 0],
      "start_image": ["7", 0]
    }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["1", 0],
      "shift": 5.0
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 6.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["4", 0]
    }
  },
  "13": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["12", 0],
      "frame_rate": 16.0,
      "loop_count": 0,
      "filename_prefix": "ai_video/wan_scene",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "pingpong": false,
      "save_output": true
    }
  }
}
